# Copy to .env.local. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TAVILY_API_KEY=
# Optional: index of prior published reviews.
GOOGLE_FACTCHECK_API_KEY=
# Optional: supplementary Google search limited to demagog.org.pl.
SERPER_API_KEY=
# Optional: EUvsDisinfo MCP key. Empty disables the EUvsDisinfo source.
EUVSDISINFO_API_KEY=
VERIFY_TIMEOUT_MS=60000
MAX_CONCURRENT_VERIFICATIONS=3
MAX_LIVE_VERIFICATIONS=100
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Local private SQLite audit, never put this file under public/ or commit it.
# Default: .runtime/audit.sqlite; retention: 24 hours, maximum 5000 checks.
# AUDIT_DB_PATH=.runtime/audit.sqlite
