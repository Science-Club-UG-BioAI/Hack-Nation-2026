# Copy to .env.local. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TAVILY_API_KEY=
VERIFY_TIMEOUT_MS=60000
MAX_CONCURRENT_VERIFICATIONS=3
# Global process budget; restart deliberately to reset.
MAX_LIVE_VERIFICATIONS=100

# Empty value disables fallback. Used only for transient service failures.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Local private SQLite audit, never put this file under public/ or commit it.
# Default: .runtime/audit.sqlite; retention: 24 hours, maximum 5000 checks.
# AUDIT_DB_PATH=.runtime/audit.sqlite
